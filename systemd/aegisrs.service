[Unit]
Description=AegisRS Lightweight VPS Security Agent & Anti-Defacement Daemon
After=network-online.target nginx.service apache2.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/aegis --config /etc/aegisrs/config.toml daemon
UMask=0077
Restart=always
RestartSec=3
LimitNOFILE=65535
RuntimeDirectory=aegisrs
RuntimeDirectoryMode=0750
StateDirectory=aegisrs
StateDirectoryMode=0700

# Hardening
NoNewPrivileges=false
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
